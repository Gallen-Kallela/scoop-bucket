{
    "version": "0.22.1",
    "description": "Manim Community Edition: engine for programmatic math animations",
    "homepage": "https://www.manim.community/",
    "license": "MIT",
    "depends": ["python", "ffmpeg"],
    "suggest": {
        "LaTeX (needed for Tex/MathTex)": "extras/miktex"
    },
    "installer": {
        "script": [
            "python -m venv \"$dir\\venv\"",
            "& \"$dir\\venv\\Scripts\\python.exe\" -m pip install --upgrade pip",
            "& \"$dir\\venv\\Scripts\\python.exe\" -m pip install manim==$version"
        ]
    },
    "bin": [
        ["venv\\Scripts\\manim.exe", "manim"]
    ],
    "checkver": {
        "url": "https://pypi.org/pypi/manim/json",
        "jsonpath": "$.info.version"
    }
}
